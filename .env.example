# =============================================================================
# ULTRA - Bletchley Park Intelligence System Environment Configuration
# Copy this file to .env and fill in your actual values.
# =============================================================================

# Google Gemini API Key (Required for LLM message classification)
GEMINI_API_KEY=your_gemini_api_key_here

# Core ULTRA Database Credentials (RadioStationSimulator & Repository)
ULTRA_DB_USER=ULTRA
ULTRA_DB_PASSWORD=change_me

# Military Branch RBAC Database Credentials
NAVY_DB_USER=Navy
NAVY_DB_PASSWORD=change_me

RAF_DB_USER=RAF
RAF_DB_PASSWORD=change_me

ARMY_DB_USER=Army
ARMY_DB_PASSWORD=change_me

PMOFFICE_DB_USER=PMOFFICE
PMOFFICE_DB_PASSWORD=change_me

SHAEF_DB_USER=SHAEF
SHAEF_DB_PASSWORD=change_me
